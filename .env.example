# Neon Postgres connection string for THIS service's own database.
# Create a dedicated Neon project/database for subagent logs — do not
# point this at any other project's database.
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/subagent_logs?sslmode=require

# Shared secret required in the `x-api-key` header for POST/PATCH /api/logs.
# Generate a random value, e.g.: openssl rand -hex 32
API_KEY=changeme-generate-a-real-secret

# Port the HTTP server listens on (optional, defaults to 3000)
PORT=3000
